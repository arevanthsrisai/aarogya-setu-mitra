# Groq API Configuration for Aarogya Setu Mitra
GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
GROQ_FAST_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3

# Server Configuration
PORT=3000
JWT_SECRET=sih-prototype-dev-secret-change-in-production
DB_PATH=./data/app.db
NODE_ENV=development

# Neon PostgreSQL (used when DATABASE_URL is set; falls back to SQLite via DB_PATH)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ABHA / ABDM integration mode: mock | sandbox | production
ABHA_MODE=mock
# Sandbox/production ABDM credentials (never exposed to the browser)
ABDM_CLIENT_ID=your_abdm_client_id
ABDM_CLIENT_SECRET=your_abdm_client_secret
# ABHA encryption RSA public key (PEM, obtained from ABDM onboarding)
ABHA_RSA_PUBLIC_KEY=
